{
  "semi": true,
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    }
  ],
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore"
}
